```react
import React, { useState, useEffect } from 'react';
import { 
  FileArchive, 
  Lock, 
  Image as ImageIcon, 
  Grid3X3, 
  ShieldCheck, 
  ShieldAlert,
  Fingerprint,
  Zap,
  ArrowRight,
  RefreshCw,
  KeyRound
} from 'lucide-react';

const App = () => {
  const [activeTab, setActiveTab] = useState('compress');

  // ==========================================
  // ユースケース1：データ圧縮（ランレングス圧縮）
  // ==========================================
  const gridSize = 8;
  const initialGrid = Array(gridSize * gridSize).fill(0); // 0: 白, 1: 黒
  const [grid, setGrid] = useState(initialGrid);

  // 初期のドット絵（スマイルマーク）
  useEffect(() => {
    const smile = Array(64).fill(0);
    // 目
    smile[18] = 1; smile[21] = 1;
    // 口
    smile[41] = 1; smile[46] = 1;
    smile[50] = 1; smile[51] = 1; smile[52] = 1; smile[53] = 1;
    setGrid(smile);
  }, []);

  const togglePixel = (index) => {
    const newGrid = [...grid];
    newGrid[index] = newGrid[index] === 0 ? 1 : 0;
    setGrid(newGrid);
  };

  const clearGrid = () => setGrid(Array(64).fill(0));

  // 圧縮計算ロジック（ランレングス圧縮）
  const calculateCompression = () => {
    let rawData = grid.join(''); // "00001000..." (64文字)
    let compressedParts = [];
    let currentChar = grid[0];
    let count = 1;

    for (let i = 1; i < grid.length; i++) {
      if (grid[i] === currentChar) {
        count++;
      } else {
        compressedParts.push({ char: currentChar, count: count });
        currentChar = grid[i];
        count = 1;
      }
    }
    compressedParts.push({ char: currentChar, count: count });

    // 圧縮後の文字列表現（例：0が5個なら "0:5"）
    const compressedString = compressedParts.map(p => `${p.char}:${p.count}`).join(',');
    
    return {
      raw: rawData,
      rawLength: rawData.length, // 64
      compressed: compressedString,
      compressedLength: compressedString.length,
      parts: compressedParts
    };
  };

  const compData = calculateCompression();

  // ==========================================
  // ユースケース2：パスワード暗号化（ハッシュ関数）
  // ==========================================
  const [password, setPassword] = useState('apple');
  const [hashResult, setHashResult] = useState('');

  // 簡易的なハッシュ関数（FNV-1a風・雪崩効果を再現）
  // ※実際はもっと複雑なSHA-256などが使われますが、体感用のアルゴリズムです
  const generateHash = (str) => {
    if (!str) return '入力してください';
    let hash = 0x811c9dc5;
    for (let i = 0; i < str.length; i++) {
      hash ^= str.charCodeAt(i);
      hash = (hash * 0x01000193) >>> 0;
    }
    // 16進数に変換し、少し長くてそれっぽく見せる
    const h1 = (hash * 13).toString(16).padStart(8, '0');
    const h2 = (hash * 29).toString(16).padStart(8, '0');
    const h3 = (hash * 37).toString(16).padStart(8, '0');
    const h4 = (hash * 53).toString(16).padStart(8, '0');
    return `${h1}${h2}${h3}${h4}`;
  };

  useEffect(() => {
    setHashResult(generateHash(password));
  }, [password]);

  return (
    <div className="min-h-screen bg-[#020617] text-slate-200 font-sans pb-24 selection:bg-emerald-500/30">
      {/* 背景エフェクト */}
      <div className="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div className="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] bg-emerald-600/10 rounded-full blur-[120px]" />
        <div className="absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] bg-amber-600/10 rounded-full blur-[120px]" />
      </div>

      <div className="relative z-10 max-w-5xl mx-auto px-4 pt-16">
        
        {/* ヘッダー */}
        <header className="text-center mb-16">
          <div className="inline-flex items-center gap-2 bg-emerald-900/30 px-4 py-2 rounded-full border border-emerald-500/30 text-emerald-400 text-xs font-bold mb-6 uppercase tracking-widest shadow-lg">
            <Zap className="w-4 h-4" />
            Algorithm Magic Vol.2
          </div>
          <h1 className="text-4xl md:text-6xl font-black mb-6 tracking-tight leading-tight">
            世界を支える<br />
            <span className="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-400 to-amber-400">アルゴリズムの魔法</span>
          </h1>
          <p className="text-slate-400 max-w-2xl mx-auto leading-relaxed text-sm md:text-base">
            なぜスマホに写真が何千枚も入るのか？なぜパスワードは盗まれないのか？<br />
            今回は「データ圧縮」と「暗号化」という、IT界の最強の魔法を解き明かします。
          </p>
        </header>

        {/* タブナビゲーション */}
        <div className="flex flex-wrap justify-center gap-2 mb-12">
          <button 
            onClick={() => setActiveTab('compress')}
            className={`px-6 py-3 rounded-2xl font-bold flex items-center gap-2 transition-all ${
              activeTab === 'compress' ? 'bg-white text-slate-950 shadow-[0_0_20px_rgba(255,255,255,0.3)] scale-105' : 'bg-slate-900/50 text-slate-400 hover:bg-slate-800'
            }`}
          >
            <FileArchive className="w-5 h-5" /> 1. 画像圧縮（ZIPの魔法）
          </button>
          <button 
            onClick={() => setActiveTab('hash')}
            className={`px-6 py-3 rounded-2xl font-bold flex items-center gap-2 transition-all ${
              activeTab === 'hash' ? 'bg-white text-slate-950 shadow-[0_0_20px_rgba(255,255,255,0.3)] scale-105' : 'bg-slate-900/50 text-slate-400 hover:bg-slate-800'
            }`}
          >
            <Lock className="w-5 h-5" /> 2. 暗号化（パスワードの魔法）
          </button>
        </div>

        {/* コンテンツエリア */}
        <div className="transition-all duration-500">

          {/* ======================================= */}
          {/* 1. ユースケース：データ圧縮 */}
          {/* ======================================= */}
          {activeTab === 'compress' && (
            <div className="animate-in fade-in slide-in-from-bottom-8 duration-700 max-w-5xl mx-auto">
              <div className="bg-slate-900 rounded-[2.5rem] p-6 md:p-10 border border-slate-800 shadow-2xl">
                
                <h2 className="text-2xl md:text-3xl font-black text-white mb-4 flex items-center gap-3">
                  <ImageIcon className="w-8 h-8 text-emerald-400" /> 
                  「画像が重い！」を解決する圧縮アルゴリズム
                </h2>
                <p className="text-slate-400 text-sm mb-8 leading-relaxed">
                  画像は「白黒白黒…」というデータの集まりです。普通に保存するとデータが巨大になりますが、プロのアルゴリズム（<strong>ランレングス圧縮</strong>など）を使うと、見た目を変えずにデータサイズを激減させることができます。
                </p>

                <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
                  {/* 左：ドット絵キャンバス */}
                  <div className="bg-slate-950 p-6 rounded-3xl border border-slate-700 flex flex-col items-center">
                    <div className="flex justify-between w-full items-center mb-4">
                      <h3 className="font-bold text-white flex items-center gap-2">
                        <Grid3X3 className="w-5 h-5 text-emerald-400" /> ドット絵を描いてみよう
                      </h3>
                      <button onClick={clearGrid} className="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3 py-1.5 rounded-lg flex items-center gap-1 transition-colors">
                        <RefreshCw className="w-3 h-3" /> 消去
                      </button>
                    </div>

                    {/* 8x8 グリッド */}
                    <div className="grid grid-cols-8 gap-1 bg-slate-800 p-2 rounded-xl border-2 border-slate-700 shadow-inner w-full max-w-[280px] aspect-square">
                      {grid.map((pixel, idx) => (
                        <div 
                          key={idx}
                          onClick={() => togglePixel(idx)}
                          className={`rounded-sm cursor-pointer transition-colors duration-100 ${pixel === 1 ? 'bg-slate-900 shadow-[inset_0_2px_4px_rgba(0,0,0,0.6)]' : 'bg-slate-100 shadow-sm'}`}
                        ></div>
                      ))}
                    </div>
                    <p className="text-xs text-slate-500 mt-4 text-center">タップ（クリック）して白黒を反転できます</p>
                  </div>

                  {/* 右：アルゴリズムによる圧縮結果 */}
                  <div className="flex flex-col gap-4">
                    
                    {/* 素人の保存方法 */}
                    <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800">
                      <h3 className="font-bold text-slate-400 text-xs uppercase tracking-widest mb-3">素人の保存方法（そのまま）</h3>
                      <div className="font-mono text-xs text-slate-300 break-all bg-slate-950 p-3 rounded-xl border border-slate-800 leading-relaxed">
                        {compData.raw}
                      </div>
                      <div className="mt-3 text-right">
                        <span className="text-red-400 font-bold text-lg">{compData.rawLength}</span>
                        <span className="text-slate-500 text-xs ml-1">文字分のデータ量</span>
                      </div>
                    </div>

                    {/* 圧縮マジック */}
                    <div className="flex justify-center">
                      <ArrowRight className="w-8 h-8 text-emerald-500 rotate-90 lg:rotate-0" />
                    </div>

                    {/* プロの保存方法 */}
                    <div className="bg-emerald-900/20 p-5 rounded-2xl border-2 border-emerald-500/50 relative overflow-hidden">
                      <div className="absolute top-0 right-0 p-4 opacity-10">
                        <FileArchive className="w-16 h-16 text-emerald-500" />
                      </div>
                      <h3 className="font-bold text-emerald-400 text-xs uppercase tracking-widest mb-3 relative z-10">プロのアルゴリズム（ランレングス圧縮）</h3>
                      
                      <div className="bg-slate-950/80 p-3 rounded-xl border border-emerald-900 text-xs mb-3 flex flex-wrap gap-1 relative z-10">
                        {compData.parts.map((p, i) => (
                          <span key={i} className={`px-2 py-1 rounded ${p.char === 1 ? 'bg-slate-800 text-white' : 'bg-slate-200 text-slate-900'}`}>
                            {p.char === 1 ? '黒' : '白'}×{p.count}
                          </span>
                        ))}
                      </div>

                      <div className="flex justify-between items-end relative z-10">
                        <p className="text-xs text-emerald-200/70 max-w-[60%]">
                          「白が連続して18個続くよ」と数え直すだけで、見た目は全く同じままデータが超軽くなります！
                        </p>
                        <div className="text-right">
                          <span className="text-emerald-400 font-black text-3xl">{compData.compressedLength}</span>
                          <span className="text-emerald-500/50 text-xs ml-1">文字に圧縮！</span>
                        </div>
                      </div>
                    </div>

                  </div>
                </div>

              </div>
            </div>
          )}

          {/* ======================================= */}
          {/* 2. ユースケース：パスワード暗号化（ハッシュ） */}
          {/* ======================================= */}
          {activeTab === 'hash' && (
            <div className="animate-in fade-in slide-in-from-bottom-8 duration-700 max-w-5xl mx-auto">
              <div className="bg-slate-900 rounded-[2.5rem] p-6 md:p-10 border border-slate-800 shadow-2xl">
                
                <h2 className="text-2xl md:text-3xl font-black text-white mb-4 flex items-center gap-3">
                  <Lock className="w-8 h-8 text-amber-400" /> 
                  パスワードを守る「不可逆の魔法」
                </h2>
                <p className="text-slate-400 text-sm mb-8 leading-relaxed">
                  任天堂やGoogleなどの企業は、あなたのパスワード（例：apple）をそのまま保存していません。<br />
                  もし悪いハッカーにデータが盗まれても絶対に読めないように、<strong>「ハッシュ関数」</strong>というアルゴリズムで、元の文字に戻せない暗号に変えてから保存しています。
                </p>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                  
                  {/* 左：ユーザー入力 */}
                  <div className="bg-slate-950 p-6 md:p-8 rounded-3xl border border-slate-700 flex flex-col justify-center">
                    <div className="w-16 h-16 bg-amber-500/20 rounded-2xl flex items-center justify-center text-amber-500 mb-6 mx-auto">
                      <KeyRound className="w-8 h-8" />
                    </div>
                    <label className="text-center font-bold text-white mb-4">
                      あなたのパスワードを入力
                    </label>
                    <input 
                      type="text" 
                      value={password}
                      onChange={(e) => setPassword(e.target.value)}
                      placeholder="パスワードを入力..."
                      className="w-full bg-slate-900 border-2 border-amber-500/50 rounded-xl px-4 py-3 text-center text-xl text-white focus:outline-none focus:border-amber-400 font-mono shadow-[0_0_15px_rgba(245,158,11,0.2)]"
                    />
                    <div className="mt-6 bg-slate-900 p-4 rounded-xl border border-slate-800">
                      <p className="text-xs text-amber-300 font-bold mb-1 flex items-center gap-1"><ShieldCheck className="w-3 h-3"/> 体感ポイント：</p>
                      <p className="text-xs text-slate-400 leading-relaxed">
                        「apple」の最後に「s」を付け足して「apples」にしてみてください。<br />
                        たった1文字変えただけで、右側の暗号が<strong className="text-white">跡形もなく全く違う形</strong>に変化します！（これを「雪崩効果」と呼びます）
                      </p>
                    </div>
                  </div>

                  {/* 右：サーバーに保存される暗号（ハッシュ） */}
                  <div className="flex flex-col gap-4">
                    <div className="flex justify-center md:hidden">
                      <ArrowRight className="w-8 h-8 text-amber-500 rotate-90" />
                    </div>

                    <div className="bg-amber-900/20 p-6 md:p-8 rounded-3xl border-2 border-amber-500/50 relative overflow-hidden flex-1 flex flex-col justify-center">
                      <div className="absolute top-0 right-0 p-4 opacity-10">
                        <Fingerprint className="w-32 h-32 text-amber-500" />
                      </div>
                      
                      <h3 className="font-bold text-amber-400 text-sm uppercase tracking-widest mb-2 relative z-10 flex items-center gap-2">
                        <ShieldAlert className="w-4 h-4" /> 企業のサーバーに保存される姿
                      </h3>
                      <p className="text-xs text-amber-200/60 mb-6 relative z-10">（ハッシュアルゴリズム通過後）</p>

                      <div className="bg-[#0f172a] p-4 rounded-xl border border-slate-800 shadow-inner relative z-10 break-all">
                        <span className="font-mono text-xl md:text-2xl text-amber-300 tracking-wider">
                          {hashResult}
                        </span>
                      </div>

                      <div className="mt-8 relative z-10">
                        <p className="text-sm text-slate-300 leading-relaxed font-bold">
                          💡 魔法のルール：
                        </p>
                        <ul className="text-xs text-slate-400 mt-2 space-y-2">
                          <li>・絶対に元の「{password || '文字'}」には戻せない。</li>
                          <li>・でも、次にあなたが同じ文字を入力すれば、必ず同じ暗号になる。</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                  
                </div>

              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  );
};

export default App;

```
